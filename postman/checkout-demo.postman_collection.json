                  "pm.test(\"Pedido muda para REEMBOLSADO\", () => pm.expect(pedido.status).to.eql(\"REEMBOLSADO\"));",
                  "pm.test(\"Total reembolsado igual ao total pago\", () => pm.expect(pedido.valorReembolsado).to.eql(pedido.total));"
