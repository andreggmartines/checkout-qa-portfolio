    {
      "name": "02 - Pedidos",
      "item": [
        {
          "name": "API03 - Criar pedido válido com Pix",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const pedido = pm.response.json();",
                  "pm.collectionVariables.set(\"pedidoId\", pedido.id);",
                  "",
                  "const esquema = {",
                  "  type: \"object\",",
                  "  required: [\"id\", \"status\", \"itens\", \"subtotal\", \"frete\", \"total\", \"saldoReembolsavel\", \"reembolsos\", \"historico\"],",
                  "  properties: {",
                  "    id: { type: \"string\", pattern: \"^PED-\\\\d{4}$\" },",
                  "    status: { type: \"string\" },",
                  "    itens: { type: \"array\", minItems: 1 },",
                  "    subtotal: { type: \"number\" },",
                  "    frete: { type: \"number\" },",
                  "    total: { type: \"number\" },",
                  "    reembolsos: { type: \"array\" }",
                  "  }",
                  "};",
                  "pm.test(\"Contrato: pedido com os campos obrigatórios\", () => pm.response.to.have.jsonSchema(esquema));",
                  "pm.test(\"Pedido criado como PAGO\", () => pm.expect(pedido.status).to.eql(\"PAGO\"));",
                  "pm.test(\"Total = R$ 129,90 + frete de R$ 19,90\", () => {",
                  "  pm.expect(pedido.subtotal).to.eql(129.9);",
                  "  pm.expect(pedido.frete).to.eql(19.9);",
                  "  pm.expect(pedido.total).to.eql(149.8);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itens\": [\n    {\n      \"produtoId\": 3,\n      \"quantidade\": 1\n    }\n  ],\n  \"cliente\": {\n    \"nome\": \"Ana Souza\",\n    \"email\": \"ana@exemplo.com\",\n    \"cep\": \"01310-100\"\n  },\n  \"pagamento\": {\n    \"metodo\": \"pix\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
