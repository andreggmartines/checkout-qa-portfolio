          }
        }
      ]
    },
    {
      "name": "01 - Produtos",
      "item": [
        {
          "name": "API01 - Listar produtos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const esquema = {",
                  "  type: \"array\",",
                  "  minItems: 1,",
                  "  items: {",
                  "    type: \"object\",",
                  "    required: [\"id\", \"nome\", \"preco\", \"estoque\"],",
                  "    properties: {",
                  "      id: { type: \"integer\" },",
                  "      nome: { type: \"string\", minLength: 1 },",
                  "      preco: { type: \"number\", exclusiveMinimum: 0 },",
                  "      estoque: { type: \"integer\", minimum: 0 }",
                  "    }",
                  "  }",
                  "};",
                  "pm.test(\"Contrato: lista de produtos com id, nome, preço e estoque\", () => pm.response.to.have.jsonSchema(esquema));",
                  "pm.test(\"Catálogo tem 6 produtos\", () => pm.expect(pm.response.json()).to.have.lengthOf(6));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produtos"
              ]
            }
          }
        },
        {
          "name": "API02 - Buscar produto inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Código de erro PRODUTO_NAO_ENCONTRADO\", () => {",
                  "  const corpo = pm.response.json();",
                  "  pm.expect(corpo.codigo).to.eql(\"PRODUTO_NAO_ENCONTRADO\");",
                  "  pm.expect(corpo.mensagem).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
