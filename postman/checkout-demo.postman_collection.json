{
  "info": {
    "name": "Checkout Demo — API",
    "description": "Testes de API do Checkout Demo (cenários API01 a API14 do plano de testes).\n\nRode em ordem: a pasta \"Preparação\" restaura os dados e algumas requisições dependem do pedido criado em API03.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Verificações aplicadas a todas as requisições",
          "pm.test(\"Tempo de resposta abaixo de 1 segundo\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
          "if (pm.response.code !== 204) {",
          "  pm.test(\"Resposta em JSON\", () => pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\"));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "chaveReembolso",
      "value": ""
    }
  ],
