{
  "name": "checkout-qa-portfolio",
  "version": "1.0.0",
  "description": "Portfólio de QA: loja de demonstração com plano de testes baseado em risco, testes E2E em Cypress e testes de API com Postman/Newman.",
  "private": true,
  "scripts": {
    "start": "node app/server.js",
    "start:bugs": "node app/server.js --bugs",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test start http://localhost:3000 cy:run",
    "test:e2e:bugs": "start-server-and-test start:bugs http://localhost:3000 cy:run",
    "api:run": "newman run postman/checkout-demo.postman_collection.json -e postman/local.postman_environment.json --reporters cli,junit --reporter-junit-export reports/newman.xml",
    "test:api": "start-server-and-test start http://localhost:3000 api:run",
    "test:api:bugs": "start-server-and-test start:bugs http://localhost:3000 api:run",
    "sql": "node sql/executar.js",
    "sql:validar": "node sql/executar.js"
  },
  "author": "André Martines",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "cypress": "^15.21.1",
    "newman": "^6.2.3",
    "start-server-and-test": "^3.0.13"
  },
  "allowScripts": {
    "cypress@15.21.1": true
  }
}
